# Sentinel OS: Docker Desktop on Windows or Coolify (server-side only)
# Local Windows: launch START_SENTINEL.cmd to generate a secure .env automatically.
# Never commit your real .env. GEMINI_API_KEY is optional.
NODE_ENV=production
PORT=3000
SENTINEL_DATA_DIR=/app/data
SENTINEL_ADMIN_PASSWORD=
SENTINEL_SESSION_SECRET=
SENTINEL_AGENT_TOKEN=
GEMINI_API_KEY=
