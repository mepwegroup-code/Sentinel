{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "agent/sentinel-agent.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?sentinelPath=:path*"
    },
    {
      "source": "/agent/:path*",
      "destination": "/api/index?sentinelAgentPath=:path*"
    },
    {
      "source": "/((?!api/|agent/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
